<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- package-info.java files are documentation/marker files; skip all checks. -->
    <suppress files="[\\/]package-info\.java$" checks=".*"/>

    <!-- Never check generated or build output. -->
    <suppress files="[\\/]build[\\/]" checks=".*"/>

    <!-- Test methods are named unit_scenarioExpectedBehaviour, e.g.
         email_routesToSesWhenAvailable. The underscore separates what is under
         test from the scenario, which makes a failing test report readable at a
         glance; camelCase throughout would run the two together. The convention
         is deliberate and applied consistently, so exempt test sources from
         MethodName rather than rename ~145 methods into something worse. -->
    <suppress files="[\\/]src[\\/](test|integrationTest)[\\/]" checks="MethodName"/>
</suppressions>
